{
  "name": "tauri-plugin-i18n-next-api",
  "version": "0.2.0",
  "author": "s00d",
  "description": "Frontend API of tauri-plugin-i18n-next: translations from the Rust catalog for @i18n-micro in Tauri 2 apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/i18n-next-rs.git",
    "directory": "crates/tauri-plugin-i18n-next"
  },
  "license": "MIT",
  "keywords": [
    "tauri",
    "plugin",
    "i18n",
    "i18n-micro",
    "translations",
    "vue",
    "rust"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-js/index.d.ts",
        "default": "./dist-js/index.js"
      },
      "require": {
        "types": "./dist-js/index.d.cts",
        "default": "./dist-js/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist-js/vue.d.ts",
        "default": "./dist-js/vue.js"
      },
      "require": {
        "types": "./dist-js/vue.d.cts",
        "default": "./dist-js/vue.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "vue": [
        "./dist-js/vue.d.ts"
      ]
    }
  },
  "files": [
    "dist-js",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm check:dist",
    "build:lib": "vite build && tsc -p tsconfig.build.json && node scripts/emit-cts-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "check:dist": "publint --strict && attw --pack . && node scripts/check-dist.mjs",
    "bench": "vitest run --mode bench",
    "bench:inventory": "node scripts/bench-inventory.mjs",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "peerDependencies": {
    "@i18n-micro/vue": "^2.1.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@i18n-micro/vue": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@i18n-micro/preact": "2.1.0",
    "@i18n-micro/react": "2.1.0",
    "@i18n-micro/runtime": "2.1.0",
    "@i18n-micro/solid": "2.1.0",
    "@i18n-micro/vue": "2.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "preact": "11.2.0",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "1.9.19",
    "tinybench": "6.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "3.5.45",
    "vue-router": "4.6.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
