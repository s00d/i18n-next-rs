{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "i18n-next leptos",
  "version": "0.1.0",
  "identifier": "com.s00d.i18n-next.leptos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": { "script": "trunk serve", "cwd": ".." },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [{ "label": "main", "title": "i18n-next · Leptos", "width": 800, "height": 600 }]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../tauri-app/src-tauri/icons/32x32.png",
      "../../tauri-app/src-tauri/icons/128x128.png",
      "../../tauri-app/src-tauri/icons/icon.ico"
    ]
  }
}
