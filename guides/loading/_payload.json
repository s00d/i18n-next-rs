cted. An evicted local page is\nread again on next use; a remote one is missing again until the next ",[133,1009,228],{},[272,1011,1013],{"id":1012},"reload-subscribe-and-watch","Reload, subscribe and watch",[277,1015,1017],{"className":279,"code":1016,"language":281,"meta":282,"style":282},"let sub = i18n.subscribe(|change| println!(\"{} v{}\", change.locale, change.version));\ni18n.reload()?;     \u002F\u002F reads every source again\ndrop(sub);          \u002F\u002F unsubscribe\n",[133,1018,1019,1079,1094],{"__ignoreMap":282},[286,1020,1021,1023,1026,1028,1031,1033,1036,1039,1042,1044,1047,1049,1052,1055,1058,1060,1063,1065,1067,1069,1071,1073,1076],{"class":288,"line":289},[286,1022,293],{"class":292},[286,1024,1025],{"class":296}," sub ",[286,1027,301],{"class":300},[286,1029,1030],{"class":296}," i18n",[286,1032,375],{"class":300},[286,1034,1035],{"class":311},"subscribe",[286,1037,1038],{"class":300},"(|",[286,1040,1041],{"class":296},"change",[286,1043,630],{"class":300},[286,1045,1046],{"class":311}," println!",[286,1048,321],{"class":300},[286,1050,1051],{"class":300},"\"{}",[286,1053,1054],{"class":327}," v",[286,1056,1057],{"class":300},"{}\"",[286,1059,502],{"class":300},[286,1061,1062],{"class":296}," change",[286,1064,375],{"class":300},[286,1066,336],{"class":296},[286,1068,502],{"class":300},[286,1070,1062],{"class":296},[286,1072,375],{"class":300},[286,1074,1075],{"class":296},"version",[286,1077,1078],{"class":300},"));\n",[286,1080,1081,1083,1085,1088,1091],{"class":288,"line":369},[286,1082,372],{"class":296},[286,1084,375],{"class":300},[286,1086,1087],{"class":311},"reload",[286,1089,1090],{"class":300},"()?;",[286,1092,1093],{"class":384},"     \u002F\u002F reads every source again\n",[286,1095,1096,1099,1101,1104,1106],{"class":288,"line":388},[286,1097,1098],{"class":311},"drop",[286,1100,321],{"class":300},[286,1102,1103],{"class":296},"sub",[286,1105,420],{"class":300},[286,1107,1108],{"class":384},"          \u002F\u002F unsubscribe\n",