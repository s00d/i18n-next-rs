# Net .wasm budgets for tools/size-check.sh (bytes after wasm-opt -Oz, minus the std runtime).
# Owner guideline: about 100 KB is a real size; raise a budget deliberately, in its own commit,
# when a stage adds a feature that needs it (CLDR data in M5/M6 is measured for 3 locales).
MICRO_BUDGET=110000
FULL_BUDGET=160000
